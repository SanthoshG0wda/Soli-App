# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soli

# --- Qdrant Cloud ---
# Cluster URL shown in the Qdrant Cloud console under "Endpoints"
# (e.g. https://xxxxx-xxxxx.cloud.qdrant.io:6333). Provide an API key.
QDRANT_URL=
QDRANT_API_KEY=
# Collection name for chunk vectors (created automatically on first use)
QDRANT_COLLECTION=soli_chunks

# --- NVIDIA NIM (OpenAI-compatible API) ---
# Hosted NIM endpoint; override to self-hosted NIM (e.g. http://localhost:8000/v1)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# API key from the NVIDIA developer/NGC portal (NVIDIA_API_KEY)
NVIDIA_API_KEY=

# --- Providers (model selection) ---
# LLM served by NIM
NIM_LLM_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
# Embedding model served by NIM (NeMo Retriever, query/passage-mode)
NIM_EMBEDDING_MODEL=nvidia/nvidia-embed-qa-4
# Native dimension of the embedding model (1024 for nvidia-embed-qa-4)
EMBEDDING_DIMENSIONS=1024

# --- Ingestion defaults ---
# Target characters per chunk and overlap between consecutive chunks
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- Retrieval ---
# Number of chunks retrieved per user question
TOP_K=5

# --- RAG generation ---
# Total character budget for the retrieved-context block sent to the LLM
# (roughly 3 tokens per 12 chars for the default model). Lower-scoring chunks
# are dropped once the budget is exceeded.
RAG_CONTEXT_MAX_CHARS=12000
# Per-chunk character cap before a chunk's content is truncated
RAG_CHUNK_MAX_CHARS=4000
# Sampling temperature for grounded answers (0-2; keep low to stay factual)
RAG_TEMPERATURE=0.2